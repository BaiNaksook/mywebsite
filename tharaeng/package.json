{
  "name": "tharaeng-chuaykan",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "firebase emulators:start --project demo-tharaeng",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-tharaeng \"node --test tests/rules.test.mjs\"",
    "test:e2e": "firebase emulators:exec --project demo-tharaeng \"node tests/e2e.mjs\"",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-thai-looped": "^5.3.0",
    "@fontsource/mitr": "^5.3.0",
    "firebase": "^12.19.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.31.0",
    "playwright": "^1.63.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.1"
  }
}
