# ค่าเหล่านี้คัดลอกจาก Firebase Console → Project settings → General → Your apps → Web app → SDK setup and configuration (Config)
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงของโปรเจกต์คุณ (ห้าม commit ไฟล์ .env.local)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ใช้ Firebase Emulator ในเครื่อง (เฉพาะตอนพัฒนา) — ตั้งเป็น true เมื่อรัน npm run dev:emulators
# เมื่อเปิดใช้ ไม่ต้องใส่ค่าด้านบน ระบบจะใช้โปรเจกต์จำลอง demo-tharaeng และข้อมูลตัวอย่างแยกจากข้อมูลจริง
VITE_USE_EMULATORS=false

# (ไม่บังคับ) URL ไฟล์ขอบเขตตำบลแบบ GeoJSON ที่ยืนยันแหล่งที่มาแล้ว เช่น /boundary/tha-raeng.geojson
VITE_BOUNDARY_GEOJSON_URL=
